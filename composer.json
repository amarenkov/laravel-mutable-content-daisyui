{
    "name": "amarenkov/laravel-mutable-content-daisyui",
    "description": "Server-rendered Blade, Livewire and daisyUI screens for laravel-mutable-content: forms, tables and management of fields and lists of values.",
    "type": "library",
    "keywords": [
        "laravel",
        "blade",
        "daisyui",
        "tailwindcss",
        "eloquent",
        "jsonb",
        "dynamic-fields",
        "custom-fields",
        "livewire"
    ],
    "homepage": "https://github.com/amarenkov/laravel-mutable-content-daisyui",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexey Marenkov",
            "email": "alex@marenkov.dev",
            "homepage": "https://github.com/amarenkov"
        }
    ],
    "support": {
        "issues": "https://github.com/amarenkov/laravel-mutable-content-daisyui/issues",
        "source": "https://github.com/amarenkov/laravel-mutable-content-daisyui"
    },
    "require": {
        "php": "^8.4",
        "amarenkov/laravel-mutable-content": "^0.7.2",
        "livewire/livewire": "^4.0",
        "mallardduck/blade-lucide-icons": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Amarenkov\\MutableContentDaisyUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amarenkov\\MutableContentDaisyUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Amarenkov\\MutableContentDaisyUi\\MutableContentDaisyUiServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "larastan/larastan": "^3.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
